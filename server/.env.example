# ============================================================
# RASIBOGA — Backend environment
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env`.
# ============================================================

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string.
# Leave EMPTY in development to let the app start a local in-memory
# MongoDB (mongodb-memory-server) that is seeded automatically.
# In production this MUST be set.
MONGODB_URI=

# Allowed frontend origin(s), comma separated.
CLIENT_URL=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary (optional in development).
# When empty, uploads are stored on the local disk under /server/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Bootstrap administrator, created on first run when no admin exists.
ADMIN_NAME=Administrator RASIBOGA
ADMIN_EMAIL=admin@rasiboga.local
ADMIN_PASSWORD=GantiSayaSegera123!

# Upload limits (megabytes)
MAX_IMAGE_MB=8
MAX_VIDEO_MB=50
