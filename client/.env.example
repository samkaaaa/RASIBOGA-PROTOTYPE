# Frontend environment
# Leave as /api to use the Vite dev proxy (recommended for local development).
# In production set the full backend URL, e.g. https://rasiboga-api.onrender.com/api
VITE_API_URL=/api

# Optional CARTO Basemaps key for the Voyager tile layer.
# IMPORTANT: CARTO's keyless endpoint returns an "API KEY REQUIRED" placeholder
# image with HTTP 200. Leave this empty unless you have a real CARTO key;
# the map then uses OpenStreetMap Deutschland / OpenTopoMap instead.
VITE_CARTO_TILE_KEY=
